<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.university.clearance.controller.LoginController">
    <VBox alignment="CENTER" spacing="20.0" styleClass="login-container">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

    <Label text="University Clearance System" styleClass="header-text" />
   <Label text="Log In" styleClass="subheader-text" />
   <TextField fx:id="emailField" promptText="Email (e.g., alice@uni.edu)" maxWidth="300.0" />
   <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300.0" />
    <Button onAction="#handleLogin" text="Log In" defaultButton="true" maxWidth="300.0" styleClass="btn-primary" />
    </VBox>
</StackPane>
