<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.university.clearance.controller.StaffDashboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label fx:id="welcomeLabel" text="Staff Panel" styleClass="subheader-text" />
        <Button onAction="#handleLogout" text="Logout" styleClass="btn-danger" />
    </HBox>

    <Label text="Pending Requests:" />
    <TableView fx:id="pendingTable" prefHeight="300.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="studentIdColumn" prefWidth="150.0" text="Student ID" />
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
        </columns>
    </TableView>

    <Label text="Review Action:" />
    <TextArea fx:id="commentArea" prefHeight="80.0" promptText="Add comments here (optional)..." />
    
    <HBox spacing="10.0">
        <Button onAction="#handleApprove" text="Approve" styleClass="btn-success" />
        <Button onAction="#handleReject" text="Reject" styleClass="btn-danger" />
    </HBox>

</VBox>
