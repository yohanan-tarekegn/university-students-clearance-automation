<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.university.clearance.controller.StudentDashboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label fx:id="welcomeLabel" text="Welcome" styleClass="subheader-text" />
        <Button onAction="#handleLogout" text="Logout" styleClass="btn-danger" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Request Clearance:" />
        <ComboBox fx:id="departmentComboBox" promptText="Select Department" />
        <Button onAction="#handleRequestClearance" text="Send Request" styleClass="btn-primary" />
    </HBox>

    <Label text="My Requests:" />
    <TableView fx:id="requestTable" prefHeight="400.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="departmentColumn" prefWidth="150.0" text="Department" />
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
            <TableColumn fx:id="commentColumn" prefWidth="300.0" text="Comment" />
        </columns>
    </TableView>

</VBox>
